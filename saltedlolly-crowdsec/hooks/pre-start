#!/usr/bin/env bash
set -euo pipefail

# Enable the AppSec (WAF) listener that NPMplus's bouncer forwards requests
# to. AppSec is a datasource, configured by an acquisition file - not a
# config.yaml key. Written on the host before the containers start: on a
# fresh install the image's entrypoint only fills in missing files
# (rsync --ignore-existing), so this file is kept. Rewritten on every start
# so the app controls its content.
# Listens on 0.0.0.0 inside the container so the published port reaches it;
# docker-compose.yml publishes 7422 for NPMplus via the Docker gateway.
ACQUIS_DIR="${APP_DATA_DIR}/data/crowdsec/config/acquis.d"

mkdir -p "$ACQUIS_DIR"
cat > "${ACQUIS_DIR}/appsec.yaml" <<'EOF'
# Managed by the Umbrel CrowdSec app - changes are overwritten on start
appsec_configs:
  - crowdsecurity/appsec-default
labels:
  type: appsec
listen_addr: 0.0.0.0:7422
source: appsec
EOF

# Receive NPMplus's access logs over syslog for behavioural detection
# (scanners, brute force, crawlers). NPMplus sends them to the Docker
# gateway on 4242/udp when it finds CrowdSec at startup; docker-compose.yml
# publishes the port on the gateway only. The ZoeyVid/npmplus-logs parser
# picks the lines out by their `npmplus` syslog tag.
cat > "${ACQUIS_DIR}/npmplus-syslog.yaml" <<'EOF'
# Managed by the Umbrel CrowdSec app - changes are overwritten on start
source: syslog
listen_addr: 0.0.0.0
listen_port: 4242
labels:
  type: syslog
EOF
