#!/usr/bin/env bash
set -uo pipefail

# Runs on the host before Authentik's containers start (also after every app
# update, with the NEW docker-compose.yml already in place). When the
# Authentik version changes it:
#
#  1. Backs up the database (pg_dump), keeping the newest 3 backups in
#     data/backups/. Authentik doesn't support downgrades, so this backup is
#     the only way back from a failed upgrade.
#  2. Steps through any Authentik release families the update skips.
#     Authentik refuses to start on a database more than one release family
#     old ("Major version skips are not allowed"); umbrelOS always installs the
#     newest version of an app, so someone who skipped a few app updates would
#     otherwise be stuck. Each missed family's last release is started until
#     healthy (which runs its migrations), then stopped.
#
# Log: data/upgrade/upgrade.log. Hook exit codes are ignored by umbrelOS, so
# failures are logged rather than stopping the app from starting.

DATA_DIR="${APP_DATA_DIR}/data"
STATE_DIR="${DATA_DIR}/upgrade"
BACKUP_DIR="${DATA_DIR}/backups"
LOG_FILE="${STATE_DIR}/upgrade.log"
VERSION_FILE="${STATE_DIR}/prepared-version"
DB_CONTAINER="${APP_ID}_postgresql_1"
STEP_CONTAINER="${APP_ID}_upgrade_1"
KEEP_BACKUPS=3
STEP_TIMEOUT_SECONDS=1800

# The last release of each release family we've shipped, oldest first, as
# "<version> <image@digest>". Maintained by authentik-build.sh when it moves
# to a new release family - don't edit by hand.
# BEGIN STEPPING STONES
STEPPING_STONES=(
)
# END STEPPING STONES

mkdir -p "$STATE_DIR" "$BACKUP_DIR"

log() {
  echo "[authentik pre-start] $*"
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG_FILE"
}

family() { echo "$1" | cut -d. -f1,2; }

# True if version/family $1 sorts strictly before $2
version_lt() {
  [[ "$1" != "$2" ]] && [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" == "$1" ]]
}

db_query() {
  docker exec "$DB_CONTAINER" psql -U authentik -d authentik -tAc "$1" 2>/dev/null | tr -d '[:space:]'
}

db_version() {
  if [[ "$(db_query "SELECT to_regclass('public.authentik_version_history') IS NOT NULL")" != "t" ]]; then
    echo ""
    return
  fi
  db_query "SELECT version FROM authentik_version_history ORDER BY timestamp DESC LIMIT 1"
}

TARGET_VERSION="$(grep -oE 'ghcr.io/goauthentik/server:[0-9]+\.[0-9]+\.[0-9]+' "${APP_DATA_DIR}/docker-compose.yml" | head -1 | cut -d: -f2)"
if [[ -z "$TARGET_VERSION" ]]; then
  log "Could not read the Authentik version from docker-compose.yml, skipping upgrade checks"
  exit 0
fi

# Fast path: nothing to do unless the Authentik version changed
if [[ "$(cat "$VERSION_FILE" 2>/dev/null)" == "$TARGET_VERSION" ]]; then
  exit 0
fi

# Fresh install: no database yet
if [[ ! -f "${DATA_DIR}/postgres/PG_VERSION" ]]; then
  echo "$TARGET_VERSION" > "$VERSION_FILE"
  exit 0
fi

log "Preparing to start Authentik ${TARGET_VERSION}"

# Start only the database. The literal "${UMBREL_ROOT}/scripts/app" below is
# replaced by umbrelOS with the path of its app script before the hook runs.
"${UMBREL_ROOT}/scripts/app" compose "${APP_ID}" up -d postgresql
for _ in $(seq 1 60); do
  docker exec "$DB_CONTAINER" pg_isready -U authentik -d authentik >/dev/null 2>&1 && break
  sleep 2
done
if ! docker exec "$DB_CONTAINER" pg_isready -U authentik -d authentik >/dev/null 2>&1; then
  log "ERROR: the database didn't start, so no backup was made. Will try again on the next start"
  exit 0
fi

CURRENT_VERSION="$(db_version)"
if [[ -z "$CURRENT_VERSION" ]]; then
  log "Database has no Authentik version yet (first start never finished), nothing to back up"
  echo "$TARGET_VERSION" > "$VERSION_FILE"
  exit 0
fi

if [[ "$CURRENT_VERSION" == "$TARGET_VERSION" ]]; then
  echo "$TARGET_VERSION" > "$VERSION_FILE"
  exit 0
fi

# 1. Back up before any version change
backup_file="${BACKUP_DIR}/authentik-${CURRENT_VERSION}-$(date +%Y%m%d-%H%M%S).dump"
log "Backing up the database (Authentik ${CURRENT_VERSION}) to ${backup_file}"
if docker exec "$DB_CONTAINER" pg_dump -U authentik -d authentik -Fc > "$backup_file" 2>>"$LOG_FILE" && [[ -s "$backup_file" ]]; then
  log "Backup done ($(du -h "$backup_file" | cut -f1))"
  ls -1t "${BACKUP_DIR}"/authentik-*.dump 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | while read -r old; do
    rm -f "$old" && log "Removed old backup $(basename "$old")"
  done
else
  rm -f "$backup_file"
  log "ERROR: backup failed. Not upgrading further in this hook; will try again on the next start"
  exit 0
fi

# 2. Step through skipped release families. Authentik itself accepts a
# database from the previous family, so run every stepping stone whose
# family is newer than the database's and older than the target's.
current_family="$(family "$CURRENT_VERSION")"
target_family="$(family "$TARGET_VERSION")"
for stone in "${STEPPING_STONES[@]}"; do
  stone_version="${stone%% *}"
  stone_image="${stone#* }"
  stone_family="$(family "$stone_version")"
  version_lt "$current_family" "$stone_family" || continue
  version_lt "$stone_family" "$target_family" || continue

  log "Upgrading the database to Authentik ${stone_version} first (${CURRENT_VERSION} → ${TARGET_VERSION} skips releases)"
  docker rm -f "$STEP_CONTAINER" >/dev/null 2>&1
  if ! docker run -d --name "$STEP_CONTAINER" --network umbrel_main_network --shm-size 512m \
      -e AUTHENTIK_POSTGRESQL__HOST="$DB_CONTAINER" \
      -e AUTHENTIK_POSTGRESQL__NAME=authentik \
      -e AUTHENTIK_POSTGRESQL__USER=authentik \
      -e AUTHENTIK_POSTGRESQL__PASSWORD="${APP_SALTEDLOLLY_AUTHENTIK_DB_PASSWORD}" \
      -e AUTHENTIK_SECRET_KEY="${APP_SALTEDLOLLY_AUTHENTIK_SECRET_KEY}" \
      -e AUTHENTIK_DISABLE_UPDATE_CHECK=true \
      -e AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true \
      -e AUTHENTIK_ERROR_REPORTING__ENABLED=false \
      -v "${DATA_DIR}/data:/data" \
      "$stone_image" server >/dev/null 2>>"$LOG_FILE"; then
    log "ERROR: could not start Authentik ${stone_version}. Authentik ${TARGET_VERSION} will refuse to start until this works; see this log"
    exit 0
  fi

  healthy=false
  for _ in $(seq 1 $((STEP_TIMEOUT_SECONDS / 5))); do
    status="$(docker inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$STEP_CONTAINER" 2>/dev/null)"
    [[ "$status" == "running healthy" ]] && { healthy=true; break; }
    [[ "$status" == running* ]] || break
    sleep 5
  done
  if ! $healthy; then
    docker logs --tail 40 "$STEP_CONTAINER" >> "$LOG_FILE" 2>&1
  fi
  docker rm -f "$STEP_CONTAINER" >/dev/null 2>&1

  CURRENT_VERSION="$(db_version)"
  if ! $healthy || [[ "$(family "$CURRENT_VERSION")" != "$stone_family" ]]; then
    log "ERROR: upgrading to Authentik ${stone_version} failed (database now at ${CURRENT_VERSION:-unknown}). Restore the backup above if needed; see this log"
    exit 0
  fi
  log "Database is now at Authentik ${CURRENT_VERSION}"
  current_family="$stone_family"
done

echo "$TARGET_VERSION" > "$VERSION_FILE"
log "Ready to start Authentik ${TARGET_VERSION} (database at ${CURRENT_VERSION})"
